{
  "manifest_version": 3,
  "name": "B站视频/音频下载器 · Bilibili Video & Audio Downloader",
  "version": "1.18.0",
  "author": "fish",
  "description": "B站视频页下载面板：可选画质/音质档位，音视频自动合并为单个 MP4（不转码），支持多分P、暂停与取消 | Download panel for Bilibili video pages: pick any quality/audio tier, auto-merge into one MP4 (no re-encode). Multi-part, pause & cancel.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "vendor/lamejs.iife.js",
        "quality.js",
        "wbi.js",
        "muxer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
